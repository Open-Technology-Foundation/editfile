# Helper functions

noarg() { (($# > 1)) || die "$ERR_USAGE" "Option ${1@Q} requires an argument"; }

# The one file name. An empty one is refused here: FILENAME being empty is
# what tells that no name has been given yet
set_filename() {
  [[ -n $1 ]] || die "$ERR_INVAL" 'A file name cannot be empty'
  [[ -z $FILENAME ]] || die "$ERR_USAGE" 'Multiple filenames specified'
  FILENAME=$1
}

# Yes/no prompt. Line-based, unlike the BCS0709 reference (read -n 1): the
# next reader of the terminal is the editor, and the rest of a typed
# "yes<Enter>" must not become its first keystrokes. Only y or yes is a yes;
# anything else, and end of input, is a no.
yn() {
  local -- reply=''
  >&2 printf '%s' "$SCRIPT_NAME: $YELLOW▲$NC ${1:-Continue?} [y/N] "
  read -r reply || raw_msg ''
  [[ ${reply,,} == @(y|yes) ]]
}

# Remove working temp files (and editor backups of them, e.g. joe's file~),
# then the directories that were made for a file which was never saved.
# rmdir takes only an empty directory: a saved file or a kept working copy
# keeps its directory.
discard_temps() {
  [[ -z $TEMP_FILE ]] || rm -f -- "$TEMP_FILE" "$TEMP_FILE~"
  [[ -z $ORIGINAL_BACKUP ]] || rm -f -- "$ORIGINAL_BACKUP" "$ORIGINAL_BACKUP~"
  TEMP_FILE='' ORIGINAL_BACKUP=''
  while [[ -n $NEW_DIR ]] && rmdir -- "$NEW_DIR" 2>/dev/null; do
    [[ $NEW_DIR != "$NEW_DIR_TOP" ]] || break
    NEW_DIR=${NEW_DIR%/*}
  done
  NEW_DIR=''
}

# Cleanup and traps

cleanup() {
  local -i exitcode=${1:-$?}
  trap - SIGINT SIGTERM SIGHUP EXIT
  # Abnormal exit after the editor ran: a working copy that differs from the
  # original is the only copy of the user's edits, so keep it and say where
  if ((exitcode && EDITOR_RAN)) && [[ -f $TEMP_FILE && ! -L $TEMP_FILE && -s $TEMP_FILE ]] \
      && ! cmp -s -- "${ORIGINAL_BACKUP:-/dev/null}" "$TEMP_FILE"; then
    error "Not saved; your edits are preserved in ${TEMP_FILE@Q}"
    TEMP_FILE=''
  fi
  discard_temps ||:  # a file left behind must not replace the status reported
  exit "$exitcode"
}

# $? in a signal trap is the status of whatever command was interrupted (0 when
# the editor has just exited cleanly), not the signal, so each signal reports
# its own 128+n. Called again after the editor, which runs under its own handler.
#bcscheck disable=BCS0603
arm_signal_traps() {
  trap 'cleanup 130' SIGINT
  trap 'cleanup 143' SIGTERM
  trap 'cleanup 129' SIGHUP
}

trap 'cleanup $?' EXIT
arm_signal_traps
# Ignore SIGPIPE: a consumer closing early (e.g. `editfile x 2>&1 | head`)
# must not abort an in-flight save; message writes degrade to EPIPE failures
# that the messaging layer tolerates (||:)
trap '' PIPE

# File type detection

# Text is whatever file(1) can name a character encoding for, UTF-16 included.
# Where it cannot (an empty file, text with stray control characters, real
# binary data) a NUL byte in the first block decides. Descriptions are not
# matched: they repeat metadata, such as the file name inside a gzip header.
is_text_file() {
  local -- filepath=$1 encoding hex

  # Nonexistent files will be created, so treat them as editable text
  [[ -e $filepath ]] || return 0

  # Directories, FIFOs, sockets and devices are not editable (a FIFO would
  # block the read below forever)
  [[ -f $filepath ]] || return 1

  encoding=$(file -b --mime-encoding -- "$filepath") || encoding=binary
  [[ $encoding == binary ]] || return 0

  # Captured, not piped into grep -q: under pipefail a reader that leaves at
  # its first match fails the pipeline exactly when a NUL has been found
  hex=$(head -c 4096 -- "$filepath" | od -An -tx1) || return 1
  [[ $hex != *' 00'* ]]
}

find_in_path() {
  local -- name=$1 dir path search=''
  local -a dirs=()
  [[ $name != -* ]] || return 1
  # Search the user's original PATH, not the hardened one (documented
  # feature), less its relative entries: a hit through one of those is not a
  # location to trust, and must not hide a later absolute one. type -P
  # reports files only; command -v would report editfile's own functions and
  # the shell's builtins first.
  IFS=: read -r -a dirs <<<"$ORIG_PATH"
  for dir in "${dirs[@]}"; do
    [[ $dir != /* ]] || search+=${search:+:}$dir
  done
  # An empty PATH would mean the current directory
  [[ -n $search ]] || return 1
  path=$(PATH=$search type -P -- "$name") || return 1
  # Resolve symlinks so we check the actual file, not a wrapper script
  realpath -- "$path"
}

# Detect file type by delegating to filetype() from sourced filetype library
# Maps library names to editfile validator names where they differ
detect_file_type() {
  local -- filepath=$1 ft

  # Callers run this inside $( ) ||, where errexit is off: without the
  # explicit return a failing library call would pass for an empty type
  ft=$(filetype "$filepath") || return 1

  case $ft in
    sh|bash)  echo 'shell' ;;     # validators expect 'shell' not 'sh'
    md)       echo 'markdown' ;;  # validators expect 'markdown' not 'md'
    *)        echo "$ft" ;;       # Most names match (json, yaml, xml, python, php, etc.)
  esac
}

# Validators
#
# Each returns 0 when the file is valid, 1 when it is not (diagnostics on
# stdout or stderr) and ERR_NODEP when there is nothing to check it with (one
# line naming what to install). Files are fed on stdin where the tool allows:
# that keeps the working copy's name out of the diagnostics.
#
# Python helpers run with -I (isolated: no current directory, PYTHON*
# variables or user site on sys.path), so a csv.py or json.py that happens to
# sit where the user is standing is never imported. The two that may need a
# `pip --user` module use -P instead, which drops only the current directory.

# JSON validation
validate_json() {
  local -- filepath=$1

  # jq accepts a stream of values; a JSON document is exactly one
  if command -v jq &>/dev/null; then
    jq -s 'if length == 1 then empty
           else error("expected exactly one top-level JSON value, found \(length)") end' \
      < "$filepath" || return 1
    return 0
  fi

  if command -v python3 &>/dev/null; then
    python3 -I -m json.tool < "$filepath" >/dev/null || return 1
    return 0
  fi

  echo 'no JSON validator available (install jq or python3)'
  return "$ERR_NODEP"
}

# YAML validation
validate_yaml() {
  local -- filepath=$1

  # Syntax and duplicate keys only. yamllint's presets, "relaxed" included,
  # also fail on whitespace style: trailing spaces, CRLF, no final newline
  if command -v yamllint &>/dev/null; then
    yamllint -d '{rules: {key-duplicates: enable}}' - < "$filepath" || return 1
    return 0
  fi

  # Fallback: PyYAML's parser, events only, so several documents and
  # application tags (!Ref, !vault) pass. Exit 2 means PyYAML is missing.
  if command -v python3 &>/dev/null; then
    local -i rc=0
    python3 -P -c '
import sys
try:
    import yaml
except ImportError:
    sys.exit(2)
try:
    for _ in yaml.parse(sys.stdin.buffer):
        pass
except yaml.YAMLError as e:
    sys.exit(str(e))
' < "$filepath" || rc=$?
    case $rc in
      0) return 0 ;;
      2) ;;
      *) return 1 ;;
    esac
  fi

  echo 'no YAML validator available (install yamllint, or python3 with PyYAML)'
  return "$ERR_NODEP"
}

# XML validation (well-formedness)
validate_xml() {
  local -- filepath=$1

  if command -v xmllint &>/dev/null; then
    xmllint --noout - < "$filepath" || return 1
    return 0
  fi

  if command -v python3 &>/dev/null; then
    python3 -I -c '
import sys, xml.etree.ElementTree as ET
try:
    ET.parse(sys.stdin.buffer)
except ET.ParseError as e:
    sys.exit(str(e))
' < "$filepath" || return 1
    return 0
  fi

  echo 'no XML validator available (install xmllint or python3)'
  return "$ERR_NODEP"
}

# Python validation
validate_python() {
  local -- filepath=$1

  # In-memory compile: the same syntax check as py_compile, without leaving
  # __pycache__ entries beside the file
  if command -v python3 &>/dev/null; then
    python3 -I -c 'import sys; compile(sys.stdin.buffer.read(), "<stdin>", "exec")' \
      < "$filepath" || return 1
    return 0
  fi

  echo 'no Python validator available (install python3)'
  return "$ERR_NODEP"
}

# Shell script validation
validate_shell() {
  local -- filepath=$1

  # -O extglob: bash -n does not execute the script's own `shopt -s extglob`,
  # so without it every +( ), @( ) or !( ) pattern is a syntax error
  bash -O extglob -n < "$filepath" || return 1

  if ((SHELLCHECK)); then
    if command -v shellcheck &>/dev/null; then
      info 'Running shellcheck...'
      local -- shellcheck_output
      # Findings are advice, not a validation failure
      shellcheck_output=$(shellcheck -- "$filepath" 2>&1 ||:)
      if [[ -n $shellcheck_output ]]; then
        warn 'Shellcheck issues:'
        raw_msg "$shellcheck_output"
      fi
    else
      warn 'shellcheck requested (-s) but not installed; skipping'
    fi
  fi

  return 0
}

# PHP validation
validate_php() {
  local -- filepath=$1 output

  if command -v php &>/dev/null; then
    # php -l announces success as well; only a failure is worth showing
    output=$(php -l < "$filepath" 2>&1) || { echo "$output"; return 1; }
    return 0
  fi

  echo 'no PHP validator available (install php-cli)'
  return "$ERR_NODEP"
}

# HTML validation (basic)
validate_html() {
  local -- filepath=$1

  if command -v tidy &>/dev/null; then
    # tidy exits 0 when clean, 1 for warnings only, 2 for errors.
    # --custom-tags: hyphenated custom elements (<my-widget>) are valid HTML
    local -i rc=0
    tidy -errors -q --custom-tags blocklevel < "$filepath" || rc=$?
    ((rc < 2)) || return 1
    return 0
  fi

  echo 'no HTML validator available (install tidy)'
  return "$ERR_NODEP"
}

# INI validation (basic)
validate_ini() {
  local -- filepath=$1

  # INI has no single grammar: multi-line values, keys without values and
  # "key: value" are all in common use. Check only what every dialect agrees
  # on: a line that opens a section must close it. The name may hold brackets
  # (EditorConfig globs such as [*.[ch]]), so the header ends at the last ].
  awk '
    /^\[/ && !/^\[.+\][[:space:]]*([#;].*)?$/ {
      printf "Line %d: malformed section header: %s\n", NR, $0
      bad = 1
    }
    END { exit bad }
  ' < "$filepath" || return 1
  return 0
}

# CSV validation (every record has the same number of fields)
validate_csv() {
  local -- filepath=$1

  # Python's csv module understands quoted fields. The delimiter is sniffed
  # (comma, semicolon, tab or pipe) and undecodable bytes are passed through,
  # so a Latin-1 export is judged on its structure, not its encoding.
  if command -v python3 &>/dev/null; then
    python3 -I -c '
import csv, sys
with open(sys.argv[1], newline="", encoding="utf-8", errors="surrogateescape") as f:
    try:
        dialect = csv.Sniffer().sniff(f.read(65536), delimiters=",;\t|")
    except csv.Error:
        dialect = csv.excel
    f.seek(0)
    reader = csv.reader(f, dialect)
    cols = None
    for row in reader:
        if not row:
            continue
        if cols is None:
            cols = len(row)
        elif len(row) != cols:
            sys.exit(f"Line {reader.line_num}: expected {cols} columns, found {len(row)}")
' "$filepath" || return 1
    return 0
  fi

  # awk fallback: plain comma split, no quoted-field support
  awk -F',' '
    NR == 1 { cols = NF; next }
    NF != cols { printf "Line %d: expected %d columns, found %d\n", NR, cols, NF; exit 1 }
  ' < "$filepath" || return 1
  return 0
}

# TOML validation
validate_toml() {
  local -- filepath=$1

  # stdlib tomllib (3.11+), then tomli, then the legacy toml module; the open
  # mode follows the module. Exit 2 means none of them is available.
  if command -v python3 &>/dev/null; then
    local -i rc=0
    python3 -P -c '
import sys
try:
    import tomllib as parser; mode = "rb"
except ImportError:
    try:
        import tomli as parser; mode = "rb"
    except ImportError:
        try:
            import toml as parser; mode = "r"
        except ImportError:
            sys.exit(2)
try:
    with open(sys.argv[1], mode) as f:
        parser.load(f)
except ValueError as e:
    sys.exit(str(e))
' "$filepath" || rc=$?
    case $rc in
      0) return 0 ;;
      2) ;;
      *) return 1 ;;
    esac
  fi

  echo 'no TOML validator available (needs python3 3.11+, or the tomli or toml module)'
  return "$ERR_NODEP"
}

# Main validation dispatcher
validate_file() {
  local -- filepath=$1 filetype=$2

  case $filetype in
    json|yaml|xml|html|python|shell|php|ini|csv|toml) ;;
    *) return 0 ;;  # no validator for this type
  esac

  info "Validating $filetype syntax"

  local -- output
  local -i rc=0
  output=$("validate_$filetype" "$filepath" 2>&1) || rc=$?

  case $rc in
    0)
      # A passing check may still have advice (shellcheck, tidy warnings)
      [[ -z $output ]] || raw_msg "$output"
      success 'Validated'
      ;;
    "$ERR_NODEP")
      warn "Not validated: $output"
      ;;
    *)
      error 'Validation failed:'
      [[ -z $output ]] || raw_msg "$output"
      return 1
      ;;
  esac
}

# File editing

edit_file() {
  local -- filepath=$1
  local -- filetype

  if [[ -e $filepath && ! -f $filepath ]]; then
    die "$ERR_TYPE" "${filepath@Q} is not a regular file"
  fi

  if [[ -e $filepath && ! -r $filepath ]]; then
    die "$ERR_ACCESS" "No read permission for ${filepath@Q}"
  fi

  if ! is_text_file "$filepath"; then
    die "$ERR_TYPE" "${filepath@Q} is a binary file"
  fi

  # The library recognises binary formats the probe above cannot (no NUL in
  # the first block), and the editor launcher would refuse them anyway
  filetype=$(detect_file_type "$filepath") || die 1 "File type detection failed for ${filepath@Q}"
  [[ $filetype != binary ]] \
    || die "$ERR_TYPE" "${filepath@Q} is classified as binary by filetype; not editing it"

  if [[ -e $filepath && ! -w $filepath ]]; then
    die "$ERR_ACCESS" "No write permission for ${filepath@Q}"
  fi

  # Record original mode so the save path can restore it (mktemp creates 0600)
  local -- orig_mode=''
  if [[ -e $filepath ]]; then
    orig_mode=$(stat -c '%a' -- "$filepath") || orig_mode=''
  fi

  local -- parent_dir
  parent_dir=${filepath%/*}
  [[ -n $parent_dir ]] || parent_dir='/'
  if [[ ! -e $filepath && ! -d $parent_dir ]]; then
    # Find the topmost directory that is about to be made, so that
    # discard_temps can take them all away again if nothing is saved
    NEW_DIR_TOP=$parent_dir
    while [[ -n ${NEW_DIR_TOP%/*} && ! -e ${NEW_DIR_TOP%/*} ]]; do
      NEW_DIR_TOP=${NEW_DIR_TOP%/*}
    done
    mkdir -p -- "$parent_dir" || die "$ERR_IO" "Cannot create parent directory ${parent_dir@Q}"
    NEW_DIR=$parent_dir
  fi
  # Temp files live beside the target, so the directory must be writable even
  # when editing an existing file
  if [[ ! -w $parent_dir ]]; then
    die "$ERR_ACCESS" "No write permission for directory ${parent_dir@Q}"
  fi

  # Preserve file extension in temp filename so editcmd's filetype detection works correctly
  local -- file_basename file_ext file_name_noext
  file_basename=${filepath##*/}

  # Extract extension, handling dotfiles correctly (.bashrc has no extension, .vimrc.bak has .bak)
  local -- check_name=${file_basename#.}
  if [[ $check_name == *.* ]]; then
    file_ext=${file_basename##*.}
    file_name_noext=${file_basename%.*}
  else
    # Single-word dotfile or no extension
    file_ext=''
    file_name_noext=$file_basename
  fi

  # Sanitize to prevent shell injection or filesystem issues
  file_name_noext=${file_name_noext:0:40}
  file_name_noext=${file_name_noext//[^a-zA-Z0-9._-]/_}
  file_ext=${file_ext:0:12}
  file_ext=${file_ext//[^a-zA-Z0-9_-]/_}

  # Place extension at end of temp filename (required for syntax highlighting)
  if [[ -n $file_ext ]]; then
    TEMP_FILE=$(mktemp -p "$parent_dir" --suffix=".$file_ext" ".${file_name_noext}_XXXXXX") \
      || die "$ERR_IO" "Cannot create temp file in ${parent_dir@Q}"
  else
    TEMP_FILE=$(mktemp -p "$parent_dir" ".${file_name_noext}_XXXXXX") \
      || die "$ERR_IO" "Cannot create temp file in ${parent_dir@Q}"
  fi

  # Keep a pristine copy to detect if user actually modified anything
  local -i file_existed=0
  if [[ -e $filepath ]]; then
    file_existed=1
    # Preserve extension for both temp files (editing + comparison)
    if [[ -n $file_ext ]]; then
      ORIGINAL_BACKUP=$(mktemp -p "$parent_dir" --suffix=".$file_ext" \
          ".${file_name_noext}_orig_XXXXXX") \
        || die "$ERR_IO" "Cannot create backup file in ${parent_dir@Q}"
    else
      ORIGINAL_BACKUP=$(mktemp -p "$parent_dir" ".${file_name_noext}_orig_XXXXXX") \
        || die "$ERR_IO" "Cannot create backup file in ${parent_dir@Q}"
    fi
    # cp -p may fail where plain cp works (ownership or ACLs that cannot be
    # copied), so its complaint is dropped and the plain copy is the fallback
    cp -p -- "$filepath" "$ORIGINAL_BACKUP" 2>/dev/null \
      || cp -- "$filepath" "$ORIGINAL_BACKUP" \
      || die "$ERR_IO" "Cannot back up ${filepath@Q}"
    cp -p -- "$filepath" "$TEMP_FILE" 2>/dev/null \
      || cp -- "$filepath" "$TEMP_FILE" \
      || die "$ERR_IO" "Cannot copy ${filepath@Q} for editing"
  else
    touch -- "$TEMP_FILE" || die "$ERR_IO" "Cannot write ${TEMP_FILE@Q}"
  fi

  # Handle readonly files: editor needs write permission
  chmod -- u+w "$TEMP_FILE" || die "$ERR_IO" "Cannot set write permission on ${TEMP_FILE@Q}"

  # Re-edit loop: allows user to fix validation errors without losing work
  local -i editing=1 file_changed=0 editor_rc=0 jump_line=$LINE_NUM
  local -a editcmd_args=()
  local -- choice=''
  while ((editing)); do
    editcmd_args=("$EDITCMD_PATH")
    ((jump_line <= 0)) || editcmd_args+=(-l "$jump_line")
    editcmd_args+=(-- "$TEMP_FILE")

    info 'Launching editor with syntax highlighting'
    editor_rc=0
    EDITOR_RAN=1
    # While the editor runs, Ctrl-C is the editor's business (interrupting a
    # :!command, say). Bash would still run a SIGINT trap of ours once the
    # editor returns, ending the session unsaved, so park a no-op handler;
    # '' would be inherited by the editor as "ignore SIGINT".
    trap : SIGINT
    # The editor is the user's program: give it back their PATH and the default
    # SIGPIPE disposition, both changed above for editfile's own safety
    (trap - PIPE; PATH=$ORIG_PATH; exec "${editcmd_args[@]}") || editor_rc=$?
    arm_signal_traps

    # Jump to line only on first edit; subsequent re-edits start at top
    jump_line=0

    # A failed editor may still have written something: cleanup keeps a
    # working copy that differs from the original
    ((editor_rc == 0)) || die 1 "Editor invocation failed (exit code $editor_rc)"

    # Exit without saving if user made no changes (avoids spurious prompts)
    file_changed=0
    if ((file_existed)); then
      if ! cmp -s -- "$ORIGINAL_BACKUP" "$TEMP_FILE"; then
        file_changed=1
      fi
    else
      if [[ -s $TEMP_FILE ]]; then
        file_changed=1
      fi
    fi

    if ((!file_changed)); then
      if ((!file_existed)) && yn "Create empty file ${filepath@Q}?"; then
        break  # an empty file the user asked for: nothing to validate
      fi
      info "No changes made to ${filepath@Q}"
      discard_temps
      return 0
    fi

    if ((VALIDATE)); then
      # A file that was untyped when editing began is typed by what was written
      # into it: a new script with no extension is "text" until it has a shebang
      [[ $filetype != text ]] || filetype=$(detect_file_type "$TEMP_FILE") || filetype=text
      if validate_file "$TEMP_FILE" "$filetype"; then
        editing=0
      else
        vecho 'Options:' \
          '  [e] - Edit again' \
          '  [s] - Save anyway (not recommended)' \
          '  [q] - Quit without saving'

        while ((1)); do
          if ! IFS= read -r -p "$SCRIPT_NAME: What would you like to do? [e/s/q]: " choice; then
            # End of input (Ctrl-D) is not a decision to discard: leave
            # through cleanup, which keeps the edits
            raw_msg ''
            die 1 'No answer at the prompt'
          fi
          case $choice in
            e|E)
              break  # Continue editing
              ;;
            s|S)
              warn 'Saving file despite validation errors...'
              editing=0
              break
              ;;
            q|Q)
              vecho 'Quitting without saving.'
              discard_temps
              return 0
              ;;
            *)
              error 'Invalid choice. Please enter e, s, or q.'
              ;;
          esac
        done
      fi
    else
      editing=0
    fi
  done

  # Lost-update protection: the target changed, or appeared, while the editor
  # was open. Declining leaves through cleanup, which keeps the edits.
  if ((file_existed)); then
    if ! cmp -s -- "$ORIGINAL_BACKUP" "$filepath"; then
      warn "${filepath@Q} was modified by another process while you were editing"
      yn 'Overwrite the external changes?' || die 1 'Declined to overwrite'
    fi
  elif [[ -e $filepath || -L $filepath ]]; then
    warn "${filepath@Q} was created by another process while you were editing"
    yn 'Overwrite it?' || die 1 'Declined to overwrite'
  fi

  # The working copy sat in a directory that others may be able to write to.
  # Install it only if it is still a regular file, never a link put in its place.
  if [[ -L $TEMP_FILE || ! -f $TEMP_FILE ]]; then
    die 1 "Working copy ${TEMP_FILE@Q} is no longer a regular file; ${filepath@Q} not saved"
  fi

  # Give the working copy its final mode before the rename, so that nothing is
  # applied through the target's path afterwards: the original mode, or the
  # umask default for a new file (mktemp made it 0600)
  if [[ -n $orig_mode ]]; then
    chmod -- "$orig_mode" "$TEMP_FILE" \
      || warn "Could not restore mode $orig_mode on ${filepath@Q}"
  else
    chmod -- "$(printf '%03o' $((0666 & ~0$(umask))))" "$TEMP_FILE" \
      || warn "Could not set the default mode on ${filepath@Q}"
  fi

  # Atomic replacement: succeeds completely or leaves the original intact.
  # -T: a directory that has appeared at the target is an error, not somewhere
  # to move the file into.
  mv -f -T -- "$TEMP_FILE" "$filepath" || die "$ERR_IO" "Failed to save ${filepath@Q}"
  rm -f -- "$TEMP_FILE~"  # editor backup of the working copy (e.g. joe's file~)
  TEMP_FILE=''  # saved: nothing left for cleanup to remove

  [[ -z $ORIGINAL_BACKUP ]] || rm -f -- "$ORIGINAL_BACKUP"
  ORIGINAL_BACKUP=''

  success "${filepath@Q} saved"
}

# Main function

main() {
  # -n has always meant --no-validate here; editfile has no dry-run mode
  #bcscheck disable=BCS0806
  while (($#)); do case $1 in
    -n|--no-validate)  VALIDATE=0 ;;
    -l|--line)         noarg "$@"; shift
                       # [[:digit:]], not [0-9]: in a regex the range follows
                       # the locale's collation and takes other scripts' digits
                       [[ $1 =~ ^[[:digit:]]+$ ]] || die "$ERR_INVAL" \
                         "Line number must be a non-negative integer: ${1@Q}"
                       # Leading zeros dropped (no octal); beyond 18 digits
                       # the arithmetic would wrap
                       [[ $1 =~ ^0*([[:digit:]]{1,18})$ ]] \
                         || die "$ERR_INVAL" "Line number too large: ${1@Q}"
                       LINE_NUM=${BASH_REMATCH[1]} ;;
    -s|--shellcheck)   SHELLCHECK=1 ;;
    -v|--verbose)      VERBOSE=1 ;;
    -q|--quiet)        VERBOSE=0 ;;
    -V|--version)      # A reader that has gone is not an error, as in usage()
                       printf '%s %s\n' "$SCRIPT_NAME" "$VERSION" 2>/dev/null ||:
                       exit 0 ;;
    -h|--help)         usage 0 ;;
    --)                shift; break ;;
    -l?*)              set -- -l "${1:2}" "${@:2}"; continue ;;  # -l42: the rest is the number
    -[nlsvqVh]?*)      set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
    -*)                die "$ERR_INVAL" "Invalid option ${1@Q}" ;;
    *)                 set_filename "$1" ;;
  esac; shift; done

  # Remaining args after -- : exactly one filename, and only if none seen yet
  if (($#)); then
    set_filename "$1"
    shift
    (($# == 0)) || die "$ERR_USAGE" 'Multiple filenames specified'
  fi

  readonly -- VALIDATE SHELLCHECK VERBOSE LINE_NUM

  [[ -n $FILENAME ]] || die "$ERR_USAGE" 'No filename specified'
  # $(...) strips trailing newlines: such a name would not survive the
  # realpath below, and a different file would be edited
  [[ $FILENAME != *$'\n' ]] \
    || die "$ERR_INVAL" "File names ending in a newline are not supported: ${FILENAME@Q}"

  # A bare name that is not a file here may be a script on PATH (searched
  # before the path is resolved); anything else is a file to create
  if [[ ! -e $FILENAME ]]; then
    local -- exec_path=''
    [[ $FILENAME == */* ]] || exec_path=$(find_in_path "$FILENAME") || exec_path=''

    if [[ -n $exec_path ]]; then
      if ! is_text_file "$exec_path"; then
        local -- here=./$FILENAME
        die "$ERR_TYPE" "${exec_path@Q}, found on PATH, is a binary file" \
          "To create a file of that name here, call it ${here@Q}"
      fi
      yn "Edit executable ${exec_path@Q}?" || exit 0
      FILENAME=$exec_path
    else
      yn "Create ${FILENAME@Q}?" || exit 0
    fi
  fi

  # Resolve path; -m allows not-yet-existing components (created in edit_file).
  # Through a variable of its own: a failed assignment would have emptied
  # FILENAME before the message could name it.
  local -- resolved
  resolved=$(realpath -m -- "$FILENAME") || die "$ERR_IO" "Cannot resolve path ${FILENAME@Q}"
  FILENAME=$resolved
  readonly -- FILENAME

  # Documented behaviour (status 16), not a safety measure: the save is a
  # rename, and a running bash keeps reading the file it opened
  if [[ $FILENAME == "$SCRIPT_PATH" ]]; then
    die "$ERR_BUSY" 'Cannot edit the running script itself; use your editor directly'
  fi

  edit_file "$FILENAME"
}

main "$@"
