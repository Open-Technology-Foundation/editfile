#!/usr/bin/env bash
# editfile - Developer's Text Editor with Built-in Validation
# A pure bash implementation with minimal external dependencies
set -euo pipefail
# Bash version guard (BCS0409): must precede the shopt below
(( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 2) )) \
  || { >&2 echo "${0##*/}: requires Bash >= 5.2 (have ${BASH_VERSION:-unknown})"; exit 2; }
shopt -s inherit_errexit shift_verbose extglob nullglob
# Capture invocation PATH before hardening: find_in_path() needs it for the
# documented $PATH-search feature (editing scripts anywhere on the user's PATH)
declare -r ORIG_PATH=$PATH
# BCS1002 hardened PATH; not readonly: find_in_path() prefixes ORIG_PATH temporarily
PATH=/usr/local/bin:/usr/bin:/bin; export PATH

# Script metadata
declare -r VERSION='1.2.0'
#shellcheck disable=SC2155  # BCS metadata: realpath in declare-r pattern
declare -r SCRIPT_PATH=$(realpath -- "$0")
#shellcheck disable=SC2034  # SCRIPT_DIR is part of the BCS0103 standard metadata set
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*} SCRIPT_NAME=${SCRIPT_PATH##*/}

# BCS0602 exit codes
declare -ri ERR_USAGE=2 ERR_IO=5 ERR_TYPE=10 ERR_ACCESS=13 ERR_BUSY=16 ERR_NODEP=18 ERR_INVAL=22

# Global variable declarations
declare -i VALIDATE=1 LINE_NUM=0 SHELLCHECK=0 VERBOSE=1
declare -- FILENAME='' TEMP_FILE='' ORIGINAL_BACKUP=''

# Color definitions (must be before dependency checks which use them)
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
fi

# Dependency checking

# Check for filetype package dependency
if ! command -v editcmd &>/dev/null; then
  >&2 cat <<INSTALL_HELP
$SCRIPT_NAME $VERSION

editfile requires the 'filetype' package to be installed.

Quick Install (one-liner):
  git clone https://github.com/Open-Technology-Foundation/filetype.git && cd filetype && sudo make install

Or step-by-step:
  git clone https://github.com/Open-Technology-Foundation/filetype.git
  cd filetype
  sudo make install

This installs filetype and editcmd to /usr/local/bin/
INSTALL_HELP
  exit "$ERR_NODEP"
fi

# Source filetype library for comprehensive file type detection
# Derive path from editcmd location (already confirmed to exist above)
#shellcheck disable=SC2155  # editcmd existence already confirmed above
declare -r EDITCMD_PATH=$(command -v editcmd)
declare -r FILETYPE_LIB="${EDITCMD_PATH%/*}/filetype"
if [[ ! -r "$FILETYPE_LIB" ]]; then
  >&2 echo "$RED Error:$NC filetype not found at ${FILETYPE_LIB@Q}"
  >&2 echo 'Please install the filetype package.'
  exit "$ERR_NODEP"
fi

# shellcheck source=/usr/local/bin/filetype
source "$FILETYPE_LIB"

# Verify critical functions are available
if ! declare -F filetype &>/dev/null; then
  >&2 echo "$RED Error:$NC filetype() function not available after sourcing ${FILETYPE_LIB@Q}"
  >&2 echo 'Please reinstall the filetype package.'
  exit "$ERR_NODEP"
fi

# Messaging functions

# Core message function using FUNCNAME for context
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    success) prefix+=" ${GREEN}✓${NC}" ;;
    warn)    prefix+=" ${YELLOW}▲${NC}" ;;
    info)    prefix+=" ${CYAN}◉${NC}" ;;
    error)   prefix+=" ${RED}✗${NC}" ;;
    *)       ;;
  esac
  # Single stderr-routing authority for all messaging (BCS0703); never fatal,
  # even when stderr is a closed pipe (SIGPIPE ignored -> EPIPE write errors)
  for msg in "$@"; do >&2 printf '%s %s\n' "$prefix" "$msg" ||:; done
}

# Standard message wrappers
vecho()   { ((VERBOSE)) || return 0; _msg "$@"; }
success() { ((VERBOSE)) || return 0; _msg "$@"; }
warn()    { _msg "$@"; }
info()    { ((VERBOSE)) || return 0; _msg "$@"; }

# Unconditional output
error() { _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# Help documentation

usage() {
  # Assembled into one variable and emitted with a single write so an early
  # reader exit (e.g. `editfile -h | grep -q ...` under pipefail) cannot
  # SIGPIPE a later heredoc
  local -- usage_text
  usage_text=$(cat <<'USAGE'
editfile - Developer's Text Editor with Built-in Validation

A terminal-based text editor designed for developers, featuring automatic syntax
validation, intelligent file type detection, and safe atomic file operations.

SYNOPSIS
  editfile [OPTIONS] filename

OPTIONS
  -n, --no-validate     Skip syntax validation (faster for large files)
  -l, --line LINE       Jump to specified line number on open
  -s, --shellcheck      Run shellcheck on shell scripts (in addition to bash -n)
  -v, --verbose         Enable informational messages (default)
  -q, --quiet           Suppress informational messages
  --                    End of options (allows filenames starting with -)
  -V, --version         Show version information and exit
  -h, --help            Display this help message

DESCRIPTION
  editfile wraps your preferred text editor with intelligent features:

  • Automatic file type detection (46+ types via extension, shebang, or content)
  • Syntax validation after editing (10+ validators with graceful fallbacks)
  • Syntax highlighting configuration for your editor (joe, nano, vim, emacs, vscode)
  • Atomic file operations using temporary files
  • Interactive validation failure handling (re-edit, force save, or quit)
  • PATH search for editing scripts and executables
  • Binary file protection (prevents corruption)
  • Symlink resolution (edits the actual file)
  • Permission checking (both file and directory)
  • Safe temporary file cleanup on exit/interrupt

VALIDATION WORKFLOW
  When you save changes, editfile automatically validates the file:

  1. If validation passes → File is saved, you're done
  2. If validation fails → You get three options:
     [e] Edit again   - Fix the errors and try again
     [s] Save anyway  - Force save despite errors (not recommended)
     [q] Quit         - Discard changes and exit

  This prevents committing broken configuration files or syntax errors.

SUPPORTED FILE TYPES

  Validated Types (syntax checking):
    JSON        - jq or python3
    YAML        - yamllint or python3 (with PyYAML)
    XML         - xmllint or python3
    HTML        - tidy (basic validation)
    Python      - python3 -m py_compile
    Shell       - bash -n (plus optional shellcheck with -s flag)
    PHP         - php -l
    INI         - awk-based validation
    CSV         - column consistency checking
    TOML        - python3 with tomli/toml

  Syntax Highlighted (40+ additional types):
    JavaScript, TypeScript, C/C++, Java, Go, Rust, Ruby, Perl, Lua, TCL,
    Erlang, Elixir, Haskell, Lisp, OCaml, Scala, Swift, R, SQL, Markdown,
    LaTeX, Diff/Patch, and many more

  Note: Files without validators still get syntax highlighting!

EDITOR SELECTION
  editfile uses the filetype package (editcmd) to launch your editor with
  proper syntax highlighting. Editor selection priority:

  1. $EDITOR environment variable (if set)
  2. Automatic detection (searches for: joe, nano, vim, vi, etc.)
  3. Falls back to: vim or joe

  Set your preferred editor:
    export EDITOR=nano      # Use nano
    export EDITOR=vim       # Use vim
    export EDITOR=joe       # Use joe

EXAMPLES

  Basic Editing:
    editfile script.py              # Edit Python file with validation
    editfile config.json            # Edit JSON with validation
    editfile -n largefile.xml       # Skip validation for large files

  Line Positioning:
    editfile -l 42 script.py        # Jump to line 42
    editfile -l 100 /etc/hosts      # Edit system file at line 100

  Shell Script Editing:
    editfile deploy.sh              # Edit with bash -n validation
    editfile -s deploy.sh           # Edit with bash -n + shellcheck

  PATH Search (edit scripts in your PATH):
    editfile myscript               # Searches PATH if not found locally
    editfile backup-script          # Edit script from /usr/local/bin

  Creating New Files:
    editfile newfile.py             # Creates new Python file
    editfile config/app.yaml        # Creates directory if needed

  Configuration Files:
    editfile ~/.bashrc              # Edit bash configuration
    editfile /etc/nginx/nginx.conf  # Edit nginx config (with sudo)

  Validation Workflows:
    editfile broken.json            # If invalid → prompted to fix
    editfile -n broken.json         # Skip validation, save anyway

USE CASES

  1. Configuration Management:
     editfile prevents saving broken config files. Edit nginx.conf, docker-compose.yml,
     or .json configs with confidence that syntax errors are caught before deployment.

  2. Script Development:
     Catch Python syntax errors, bash mistakes, or PHP issues immediately while editing,
     rather than discovering them when the script runs.

  3. DevOps/SRE Work:
     Quickly edit scripts in /usr/local/bin or other PATH locations without typing
     full paths. Validation ensures no broken scripts get deployed.

  4. Data File Editing:
     Edit CSV files with automatic column consistency checking, or YAML/JSON data
     with immediate feedback on structural problems.

DEPENDENCIES

  Required:
    • bash 5.2+
    • filetype package - https://github.com/Open-Technology-Foundation/filetype
      Provides: filetype, editcmd
      Install: git clone <url> && cd filetype && sudo make install

  Optional (for validation):
    • jq              - JSON validation (fastest)
    • yamllint        - YAML validation
    • xmllint         - XML validation
    • python3         - Fallback validator for JSON/YAML/XML/Python/TOML
    • PyYAML          - For YAML validation (pip install PyYAML)
    • tomli           - For TOML validation (pip install tomli)
    • shellcheck      - Advanced shell script analysis (use with -s flag)
    • php             - PHP syntax checking
    • tidy            - HTML validation

  Note: Missing validators cause warnings but don't prevent editing.

ENVIRONMENT VARIABLES

  EDITOR    Your preferred text editor (e.g., vim, nano, joe, emacs)
            If not set, editfile automatically detects available editors

BEHAVIOR

  File Not Found:
    • If filename has no slashes → searches $PATH for the file
    • Prompts "Edit executable '/path/to/script'?" if found
    • Otherwise prompts "Create 'filename'?" for new files

  Validation Failure:
    • Shows validation error output
    • Offers three choices: [e]dit again, [s]ave anyway, [q]uit
    • Re-editing keeps your changes in the temp file

  No Changes:
    • Detects if you exited without changes
    • Skips validation and exits silently (no unnecessary prompts)

  Binary Files:
    • Refuses to edit binary executables (prevents corruption)
    • Uses multiple detection methods (file command + null byte check)

  Permissions:
    • Checks write permission before editing
    • Checks directory write permission for new files
    • Creates parent directories if needed (mkdir -p)

  Atomic Operations:
    • Edits temporary copy (preserves file extension for syntax highlighting)
    • Only replaces original on successful validation
    • Original file never corrupted if process interrupted
    • Permissions preserved (umask-derived for new files); replacement is by
      rename, so hard links to the old file are broken
    • Warns before overwriting if the file changed on disk while editing

SECURITY
  editfile implements several security measures:
  • Command injection prevention (filenames safely passed via sys.argv[])
  • Temp-file basename and extension sanitization
  • Binary file detection (prevents accidental editing/corruption)
  • Symlink and path canonicalisation before editing
  • Self-edit protection (prevents corrupting the running script)

  See SECURITY.md for details: https://github.com/Open-Technology-Foundation/editfile

EXIT STATUS (BCS0602)
  0   Success (file saved or no changes)
  1   Runtime error (editor failure, declined overwrite, internal error)
  2   Usage error (missing/extra arguments)
  5   I/O error (cannot create directory)
  10  Type error (file is binary)
  13  Permission denied (file or directory)
  16  Resource busy (self-edit prevention)
  18  Missing dependency (filetype package)
  22  Invalid option

FILES
  Temporary files are created in the same directory as the file being edited,
  using the pattern .{filename}_XXXXXX (auto-cleaned on exit/interrupt).

TIPS

  • Use -n for large files where validation would be slow
  • Use -s for shell scripts to catch common mistakes early
  • Set EDITOR once in ~/.bashrc for consistent editor selection
  • Trust the validation - if it fails, there's usually a real problem
  • Use -l with grep: grep -n "TODO" file.py → editfile -l <line> file.py

SEE ALSO
  editcmd(1), vim(1), nano(1), joe(1), shellcheck(1), jq(1)

BUGS
  Report issues: https://github.com/Open-Technology-Foundation/editfile/issues

AUTHOR
  Open Technology Foundation
USAGE
  )
  printf '%s\n\nVERSION\n  %s %s\n\nCOPYRIGHT\n  GNU General Public License v3.0\n  https://www.gnu.org/licenses/gpl-3.0.en.html\n\n' \
    "$usage_text" "$SCRIPT_NAME" "$VERSION"
  exit "${1:-0}"
}

# Helper functions

noarg() { (($# > 1)) || die "$ERR_USAGE" "Option ${1@Q} requires an argument"; }

# Yes/no prompt (BCS0709)
yn() {
  local -- REPLY
  >&2 printf '%s' "$SCRIPT_NAME: $YELLOW▲$NC ${1:-Continue?} y/n "
  read -r -n 1
  >&2 echo
  [[ ${REPLY,,} == y ]]
}

# Remove working temp files (and editor backups of them, e.g. joe's file~)
discard_temps() {
  [[ -z "$TEMP_FILE" ]] || rm -f -- "$TEMP_FILE" "${TEMP_FILE}~"
  [[ -z "$ORIGINAL_BACKUP" ]] || rm -f -- "$ORIGINAL_BACKUP" "${ORIGINAL_BACKUP}~"
  TEMP_FILE='' ORIGINAL_BACKUP=''
}

# Cleanup and traps

cleanup() {
  local -i exitcode=${1:-$?}
  trap - SIGINT SIGTERM SIGHUP EXIT
  discard_temps ||:
  exit "$exitcode"
}

trap 'cleanup $?' SIGINT SIGTERM SIGHUP EXIT
# Ignore SIGPIPE: a consumer closing early (e.g. `editfile x 2>&1 | head`)
# must not abort an in-flight save; message writes degrade to EPIPE failures
# that the messaging layer tolerates (||:)
trap '' PIPE

# File type detection

is_text_file() {
  local -- filepath="$1"

  # Nonexistent files will be created, so treat them as editable text
  [[ -e "$filepath" ]] || return 0

  # Directories, FIFOs, sockets and devices are not editable (a FIFO would
  # block the null-byte probe below forever)
  [[ -f "$filepath" ]] || return 1

  local -- file_info
  file_info=$(file -b "$filepath" 2>/dev/null)

  # Trust file(1) when it identifies text or scripts
  if [[ $file_info == *text* ]] || [[ $file_info == *script* ]]; then
    return 0
  fi

  # Prevent editing compiled binaries (could corrupt them)
  if [[ $file_info == *executable* ]] || [[ $file_info == *ELF* ]]; then
    return 1
  fi

  # When file(1) is ambiguous, check for null bytes to distinguish binary from text
  # This catches files with misleading extensions or missing magic numbers
  if head -c 4096 -- "$filepath" 2>/dev/null | od -An -tx1 | grep -q ' 00' 2>/dev/null; then
    return 1  # Binary data
  else
    return 0  # Appears to be text
  fi
}

find_in_path() {
  local -- name=$1 path
  [[ "$name" == -* ]] && return 1
  # Search the user's original PATH, not the hardened one (documented feature)
  path=$(PATH=$ORIG_PATH command -v -- "$name" 2>/dev/null) || return 1
  # command -v returns bare names for builtins/functions/aliases; only real
  # filesystem hits are editable
  [[ "$path" == /* ]] || return 1
  # Resolve symlinks so we check the actual file, not a wrapper script
  realpath -- "$path"
}

# Detect file type by delegating to filetype() from sourced filetype library
# Maps library names to editfile validator names where they differ
detect_file_type() {
  local -- filepath="$1"
  local -- ft

  # Use comprehensive filetype detection from library
  ft=$(filetype "$filepath")

  # Map filetype names to editfile validator names where they differ
  case $ft in
    sh|bash)  echo 'shell' ;;     # validators expect 'shell' not 'sh'
    md)       echo 'markdown' ;;  # validators expect 'markdown' not 'md'
    *)        echo "$ft" ;;       # Most names match (json, yaml, xml, python, php, etc.)
  esac
}

# Validators

# JSON validation
validate_json() {
  local -- filepath="$1"

  # Try jq first (fastest and most reliable)
  if command -v jq &>/dev/null; then
    if ! jq empty "$filepath" 2>&1; then
      return 1
    fi
    return 0
  fi

  # Fallback to Python
  if command -v python3 &>/dev/null; then
    if ! python3 -m json.tool "$filepath" &>/dev/null; then
      return 1
    fi
    return 0
  fi

  warn 'No JSON validator available' '(install jq or python3)'
  return 0  # Don't fail if no validator available
}

# YAML validation
validate_yaml() {
  local -- filepath="$1"

  # Try yamllint first; relaxed profile reports syntax errors without failing
  # on style lint (line length etc.) — this is a syntax check, not a linter
  if command -v yamllint &>/dev/null; then
    if ! yamllint -d relaxed -- "$filepath"; then
      return 1
    fi
    return 0
  fi

  # Fallback to Python with PyYAML; a missing module is a warning, not a failure
  if command -v python3 &>/dev/null; then
    local -i rc=0
    python3 -c '
import sys
try:
    import yaml
except ImportError:
    sys.exit(2)
yaml.safe_load(open(sys.argv[1]))' "$filepath" || rc=$?
    case $rc in
      0) return 0 ;;
      2) warn 'No YAML validator available' '(install yamllint or python3 with PyYAML)'
         return 0 ;;
      *) return 1 ;;
    esac
  fi

  warn 'No YAML validator available' '(install yamllint or python3 with PyYAML)'
  return 0
}

# XML validation
validate_xml() {
  local -- filepath="$1"

  # Try xmllint first
  if command -v xmllint &>/dev/null; then
    if ! xmllint --noout "$filepath" 2>&1; then
      return 1
    fi
    return 0
  fi

  # Fallback to Python
  if command -v python3 &>/dev/null; then
    if ! python3 -c 'import sys, xml.etree.ElementTree as ET; ET.parse(sys.argv[1])' "$filepath" 2>&1; then
      return 1
    fi
    return 0
  fi

  warn 'No XML validator available' '(install xmllint or python3)'
  return 0
}

# Python validation
validate_python() {
  local -- filepath="$1"

  # In-memory compile: same syntax check as py_compile without littering
  # the target directory with __pycache__ entries
  if command -v python3 &>/dev/null; then
    if ! python3 -c 'import sys; compile(open(sys.argv[1], "rb").read(), sys.argv[1], "exec")' "$filepath" 2>&1; then
      return 1
    fi
    return 0
  fi

  warn 'Python3 not available for validation'
  return 0
}

# Shell script validation
validate_shell() {
  local -- filepath="$1"

  # Basic syntax check with bash -n
  bash -n "$filepath" 2>&1 || return 1

  # Run shellcheck if requested
  if ((SHELLCHECK)); then
    if command -v shellcheck &>/dev/null; then
      info 'Running shellcheck...'
      local -- shellcheck_output
      shellcheck_output=$(shellcheck "$filepath" 2>&1 ||:)
      if [[ -n "$shellcheck_output" ]]; then
        warn 'Shellcheck issues:'
        >&2 echo "$shellcheck_output" ||:
      fi
    else
      warn 'shellcheck requested (-s) but not installed; skipping'
    fi
  fi

  return 0
}

# PHP validation
validate_php() {
  local -- filepath="$1"

  if command -v php &>/dev/null; then
    if ! php -l "$filepath" 2>&1; then
      return 1
    fi
    return 0
  fi

  warn 'PHP not available for validation'
  return 0
}

# HTML validation (basic)
validate_html() {
  local -- filepath="$1"

  if command -v tidy &>/dev/null; then
    # tidy exit codes: 0=clean, 1=warnings only, 2=errors
    local -i rc=0
    tidy -errors -q "$filepath" || rc=$?
    ((rc >= 2)) && return 1
    return 0
  fi

  warn 'No HTML validator available' '(install tidy)'
  return 0
}

# INI validation (basic)
validate_ini() {
  local -- filepath="$1"

  # Basic INI validation with awk; report the offending line, not just rc
  local -i rc=0
  awk '
    /^[[:space:]]*$/ { next }  # Skip empty lines
    /^[[:space:]]*[#;]/ { next }  # Skip comments
    /^[[:space:]]*\[.*\][[:space:]]*$/ { next }  # Section headers
    /^[[:space:]]*[^=]+=.*$/ { next }  # Key=value pairs
    { printf "Line %d: not a section, comment, or key=value pair: %s\n", NR, $0; exit 1 }
  ' "$filepath" || rc=$?
  return "$rc"
}

# CSV validation (check column consistency)
validate_csv() {
  local -- filepath="$1"

  # Python csv module handles RFC 4180 quoted fields; awk cannot
  if command -v python3 &>/dev/null; then
    local -i rc=0
    python3 -c '
import sys, csv
with open(sys.argv[1], newline="") as f:
    rows = [r for r in csv.reader(f) if r]
if rows:
    cols = len(rows[0])
    for i, row in enumerate(rows[1:], 2):
        if len(row) != cols:
            sys.exit(f"Line {i}: Expected {cols} columns, found {len(row)}")' "$filepath" || rc=$?
    return "$rc"
  fi

  # awk fallback: naive comma split, no quoted-field support
  local -i rc=0
  awk -F',' '
    NR==1 { cols=NF; next }
    NF != cols {
      print "Line " NR ": Expected " cols " columns, found " NF
      exit 1
    }
  ' "$filepath" || rc=$?
  return "$rc"
}

# TOML validation
validate_toml() {
  local -- filepath="$1"

  # Try Python: stdlib tomllib (3.11+), then tomli, then legacy toml.
  # Binary vs text open mode follows the imported module, not a dir() probe.
  if command -v python3 &>/dev/null; then
    local -i rc=0
    python3 -c '
import sys
try:
    import tomllib as parser; mode = "rb"
except ImportError:
    try:
        import tomli as parser; mode = "rb"
    except ImportError:
        try:
            import toml as parser; mode = "r"
        except ImportError:
            sys.exit(2)
with open(sys.argv[1], mode) as f:
    parser.load(f)' "$filepath" || rc=$?
    case $rc in
      0) return 0 ;;
      2) warn 'No TOML parser available' '(needs python3 3.11+, or the tomli/toml module)'
         return 0 ;;
      *) return 1 ;;
    esac
  fi

  warn 'Python3 not available for TOML validation'
  return 0
}

# Main validation dispatcher
validate_file() {
  local -- filepath="$1"
  local -- filetype="$2"

  # Check if this file type has a validator
  case $filetype in
    json|yaml|xml|html|python|shell|php|ini|csv|toml)
      # Has a validator - show message and validate
      info "Validating $filetype file ${filepath@Q}"
      ;;
    *)
      # No validator for this type - skip silently
      return 0
      ;;
  esac

  local -- output
  local -i exit_code=0
  case $filetype in
    json)   output=$(validate_json "$filepath" 2>&1)   || exit_code=$? ;;
    yaml)   output=$(validate_yaml "$filepath" 2>&1)   || exit_code=$? ;;
    xml)    output=$(validate_xml "$filepath" 2>&1)    || exit_code=$? ;;
    html)   output=$(validate_html "$filepath" 2>&1)   || exit_code=$? ;;
    python) output=$(validate_python "$filepath" 2>&1) || exit_code=$? ;;
    shell)  output=$(validate_shell "$filepath" 2>&1)  || exit_code=$? ;;
    php)    output=$(validate_php "$filepath" 2>&1)    || exit_code=$? ;;
    ini)    output=$(validate_ini "$filepath" 2>&1)    || exit_code=$? ;;
    csv)    output=$(validate_csv "$filepath" 2>&1)    || exit_code=$? ;;
    toml)   output=$(validate_toml "$filepath" 2>&1)   || exit_code=$? ;;
    *)      die 1 "Internal error: validator list mismatch for ${filetype@Q}" ;;
  esac

  # Always show output if there is any (for shellcheck warnings, etc.)
  if [[ -n "$output" ]]; then
    >&2 echo "$output" ||:
  fi

  if ((exit_code)); then
    error 'Validation failed:'
    return 1
  fi

  success 'Validated'
  return 0
}

# File editing

edit_file() {
  local -- filepath="$1"
  local -- filetype

  if [[ -e "$filepath" && ! -f "$filepath" ]]; then
    die "$ERR_TYPE" "${filepath@Q} is not a regular file"
  fi

  if ! is_text_file "$filepath"; then
    die "$ERR_TYPE" "${filepath@Q} is a binary file"
  fi

  # Check write permissions
  if [[ -e "$filepath" ]] && [[ ! -w "$filepath" ]]; then
    die "$ERR_ACCESS" "No write permission for ${filepath@Q}"
  fi

  # Record original mode so the save path can restore it (mktemp creates 0600)
  local -- orig_mode=''
  if [[ -e "$filepath" ]]; then
    orig_mode=$(stat -c '%a' -- "$filepath" 2>/dev/null) || orig_mode=''
  fi

  local -- parent_dir
  parent_dir=${filepath%/*}
  [[ -n "$parent_dir" ]] || parent_dir='/'
  if [[ ! -e "$filepath" && ! -d "$parent_dir" ]]; then
    mkdir -p -- "$parent_dir" || die "$ERR_IO" "Cannot create parent directory ${parent_dir@Q}"
  fi
  # Temp files live beside the target, so the directory must be writable even
  # when editing an existing file
  if [[ ! -w "$parent_dir" ]]; then
    die "$ERR_ACCESS" "No write permission for directory ${parent_dir@Q}"
  fi

  filetype=$(detect_file_type "$filepath") || die 1 "File type detection failed for ${filepath@Q}"

  # Preserve file extension in temp filename so editcmd's filetype detection works correctly
  local -- file_basename file_ext file_name_noext
  file_basename=${filepath##*/}

  # Extract extension, handling dotfiles correctly (.bashrc has no extension, .vimrc.bak has .bak)
  local -- check_name="${file_basename#.}"
  if [[ $check_name == *.* ]]; then
    # Multi-dot filename: extract everything after last dot
    file_ext="${file_basename##*.}"
    file_name_noext="${file_basename%.*}"
  else
    # Single-word dotfile or no extension
    file_ext=""
    file_name_noext="$file_basename"
  fi

  # Sanitize to prevent shell injection or filesystem issues
  file_name_noext="${file_name_noext:0:40}"
  file_name_noext="${file_name_noext//[^a-zA-Z0-9._-]/_}"
  file_ext="${file_ext:0:12}"
  file_ext="${file_ext//[^a-zA-Z0-9_-]/_}"

  # Place extension at end of temp filename (required for syntax highlighting)
  if [[ -n "$file_ext" ]]; then
    TEMP_FILE=$(mktemp -p "$parent_dir" --suffix=".${file_ext}" ".${file_name_noext}_XXXXXX") \
      || die "$ERR_IO" "Cannot create temp file in ${parent_dir@Q}"
  else
    TEMP_FILE=$(mktemp -p "$parent_dir" ".${file_name_noext}_XXXXXX") \
      || die "$ERR_IO" "Cannot create temp file in ${parent_dir@Q}"
  fi

  # Keep a pristine copy to detect if user actually modified anything
  local -i file_existed=0
  if [[ -e "$filepath" ]]; then
    file_existed=1
    # Preserve extension for both temp files (editing + comparison)
    if [[ -n "$file_ext" ]]; then
      ORIGINAL_BACKUP=$(mktemp -p "$parent_dir" --suffix=".${file_ext}" ".${file_name_noext}_orig_XXXXXX") \
        || die "$ERR_IO" "Cannot create backup file in ${parent_dir@Q}"
    else
      ORIGINAL_BACKUP=$(mktemp -p "$parent_dir" ".${file_name_noext}_orig_XXXXXX") \
        || die "$ERR_IO" "Cannot create backup file in ${parent_dir@Q}"
    fi
    cp -p -- "$filepath" "$ORIGINAL_BACKUP" 2>/dev/null \
      || cp -- "$filepath" "$ORIGINAL_BACKUP" \
      || die "$ERR_IO" "Cannot back up ${filepath@Q}"
    cp -p -- "$filepath" "$TEMP_FILE" 2>/dev/null \
      || cp -- "$filepath" "$TEMP_FILE" \
      || die "$ERR_IO" "Cannot copy ${filepath@Q} for editing"
  else
    touch -- "$TEMP_FILE" || die "$ERR_IO" "Cannot write ${TEMP_FILE@Q}"
  fi

  # Handle readonly files: editor needs write permission
  chmod u+w -- "$TEMP_FILE" || die "$ERR_IO" "Cannot set write permission on ${TEMP_FILE@Q}"

  # Re-edit loop: allows user to fix validation errors without losing work
  local -i editing=1 file_changed=0 editor_rc=0
  local -a editcmd_args=()
  local -- choice='' saved_temp=''
  while ((editing)); do
    editcmd_args=(editcmd)
    ((LINE_NUM <= 0)) || editcmd_args+=(-l "$LINE_NUM")
    editcmd_args+=("$TEMP_FILE")

    info 'Launching editor with syntax highlighting'
    editor_rc=0
    "${editcmd_args[@]}" || editor_rc=$?

    # Jump to line only on first edit; subsequent re-edits start at top
    LINE_NUM=0

    # Exit without saving if user made no changes (avoids spurious prompts)
    file_changed=0
    if ((file_existed)); then
      if ! cmp -s -- "$ORIGINAL_BACKUP" "$TEMP_FILE"; then
        file_changed=1
      fi
    else
      # New file: count as changed if non-empty
      if [[ -s "$TEMP_FILE" ]]; then
        file_changed=1
      fi
    fi

    if ((editor_rc)); then
      # Editor failed: never silently discard work it may have written
      if ((file_changed)); then
        saved_temp="$TEMP_FILE"
        TEMP_FILE=''
        warn "Your edits are preserved in ${saved_temp@Q}"
      fi
      die 1 "Editor invocation failed (exit code $editor_rc)"
    fi

    if ((!file_changed)); then
      if ((!file_existed)) && yn "Create empty file ${filepath@Q}?"; then
        file_changed=1
      else
        info "No changes made to '$filepath'"
        discard_temps
        return 0
      fi
    fi

    # Validate only if enabled and file was actually modified
    if ((VALIDATE)); then
      if validate_file "$TEMP_FILE" "$filetype"; then
        editing=0
      else
        # Allow user to re-edit, force-save, or abort
        vecho '' 'Options:' \
          '  [e] - Edit again' \
          '  [s] - Save anyway (not recommended)' \
          '  [q] - Quit without saving'

        while ((1)); do
          if ! IFS= read -r -p "$SCRIPT_NAME: What would you like to do? [e/s/q]: " choice; then
            # EOF (Ctrl-D): preserve edits rather than silently destroying them
            >&2 echo ||:
            saved_temp="$TEMP_FILE"
            TEMP_FILE=''
            die 1 "EOF at prompt; your edits are preserved in ${saved_temp@Q}"
          fi
          case $choice in
            e|E)
              break  # Continue editing
              ;;
            s|S)
              warn 'Saving file despite validation errors...'
              editing=0
              break
              ;;
            q|Q)
              vecho 'Quitting without saving.'
              discard_temps
              return 0
              ;;
            *)
              error "Invalid choice. Please enter 'e', 's', or 'q'."
              ;;
          esac
        done
      fi
    else
      editing=0
    fi
  done

  # Lost-update protection: detect external modification since editing began
  if ((file_existed)) && ! cmp -s -- "$ORIGINAL_BACKUP" "$filepath"; then
    warn "${filepath@Q} was modified by another process while you were editing"
    if ! yn 'Overwrite the external changes?'; then
      saved_temp="$TEMP_FILE"
      TEMP_FILE=''
      [[ -z "$ORIGINAL_BACKUP" ]] || rm -f -- "$ORIGINAL_BACKUP"
      ORIGINAL_BACKUP=''
      die 1 "Not saved; your edits are preserved in ${saved_temp@Q}"
    fi
  fi

  # Atomic file replacement: either succeeds completely or leaves original intact
  mv -f -- "$TEMP_FILE" "$filepath" || die "$ERR_IO" "Failed to save ${filepath@Q}"
  rm -f -- "${TEMP_FILE}~"  # editor backup of the temp (e.g. joe's file~)
  TEMP_FILE=''  # Prevent cleanup from removing the saved file

  # mktemp created the temp 0600 (and chmod u+w may have widened it): restore
  # the original mode, or a umask-derived default for new files
  if [[ -n "$orig_mode" ]]; then
    chmod "$orig_mode" -- "$filepath" 2>/dev/null \
      || warn "Could not restore mode $orig_mode on ${filepath@Q}"
  else
    local -- new_mode
    new_mode=$(printf '%03o' $(( 0666 & ~0$(umask) )))
    chmod "$new_mode" -- "$filepath" 2>/dev/null ||:
  fi

  [[ -z "$ORIGINAL_BACKUP" ]] || rm -f -- "$ORIGINAL_BACKUP"
  ORIGINAL_BACKUP=''

  success "'$filepath' saved"
}

# Main function

main() {
  # Note: -n is --no-validate (long-documented interface), not BCS0806 dry-run
  while (($#)); do case $1 in
    -n|--no-validate)  VALIDATE=0 ;;
    -l|--line)         noarg "$@"; shift
                       [[ $1 =~ ^[0-9]+$ ]] || die "$ERR_INVAL" "Line number must be a non-negative integer: ${1@Q}"
                       LINE_NUM=$((10#$1)) ;;  # 10# prevents octal surprise on leading zeros
    -s|--shellcheck)   SHELLCHECK=1 ;;
    -v|--verbose)      VERBOSE=1 ;;
    -q|--quiet)        VERBOSE=0 ;;
    -V|--version)      echo "$SCRIPT_NAME $VERSION"; exit 0 ;;
    -h|--help)         usage 0 ;;
    --)                shift; break ;;
    -[nlsvqVh]?*)      set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
    -*)                die "$ERR_INVAL" "Invalid option ${1@Q}" ;;
    *)                 [[ -z "$FILENAME" ]] || die "$ERR_USAGE" 'Multiple filenames specified'
                       FILENAME="$1" ;;
  esac; shift; done

  # Remaining args after -- : exactly one filename, and only if none seen yet
  if (($#)); then
    [[ -z "$FILENAME" ]] || die "$ERR_USAGE" 'Multiple filenames specified'
    FILENAME="$1"
    shift
    (($# == 0)) || die "$ERR_USAGE" 'Multiple filenames specified'
  fi

  readonly -- VALIDATE SHELLCHECK VERBOSE

  # Validate arguments
  [[ -n "$FILENAME" ]] || die "$ERR_USAGE" 'No filename specified'

  # Check if file exists or search in PATH (before resolving path)
  if [[ ! -e "$FILENAME" ]]; then
    local -- exec_path

    # If no directory separator, try to find in PATH
    if [[ "$FILENAME" != */* ]]; then
      exec_path=$(find_in_path "$FILENAME") || exec_path=''

      if [[ -n "$exec_path" ]]; then
        # Found in PATH - check if it's a text file
        if is_text_file "$exec_path"; then
          if yn "Edit executable ${exec_path@Q}?"; then
            FILENAME="$exec_path"
          else
            exit 0
          fi
        else
          error "${exec_path@Q} is a binary file"
          exit "$ERR_TYPE"
        fi
      else
        # Not found in PATH - offer to create
        yn "Create ${FILENAME@Q}?" || exit 0
      fi
    else
      # Contains path separator - just offer to create
      yn "Create ${FILENAME@Q}?" || exit 0
    fi
  fi

  # Resolve path; -m allows not-yet-existing components (created in edit_file)
  FILENAME=$(realpath -m -- "$FILENAME") || die "$ERR_IO" "Cannot resolve path ${FILENAME@Q}"
  readonly -- FILENAME

  # Prevent editing the script itself while it's running
  if [[ "$FILENAME" == "$SCRIPT_PATH" ]]; then
    die "$ERR_BUSY" 'Cannot edit the running script itself.' \
      'This could cause corruption during atomic file replacement.'
  fi

  edit_file "$FILENAME"
}

main "$@"
