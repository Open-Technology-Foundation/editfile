  # SIGPIPE is ignored below, so the write fails instead of ending the script
  printf '%s\n\nVERSION\n  %s %s\n\nCOPYRIGHT\n  %s\n  %s\n\n' \
    "$usage_text" "$SCRIPT_NAME" "$VERSION" \
